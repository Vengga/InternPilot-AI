# ── Alibaba Cloud Model Studio (Qwen Cloud) ──────────────────────────────
# Get your API key: https://www.alibabacloud.com/help/en/model-studio/get-api-key
# This single variable is all the backend needs to talk to Qwen on Alibaba Cloud.
DASHSCOPE_API_KEY=sk-your-key-here

# Region endpoint. Singapore (international) is correct for most users incl. Malaysia.
#   Singapore:      https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   US (Virginia):  https://dashscope-us.aliyuncs.com/compatible-mode/v1
#   China (Beijing):https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Text model used for the agent pipeline.
QWEN_MODEL=qwen-plus
